<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head', { title: 'Dashboard' }) %>
</head>
<body>
  <%- include('partials/navbar', { active: 'dashboard' }) %>

  <main>
    <section class="section">
      <div class="section-inner">
        <h1>Dashboard Produk</h1>
        <p class="hero-lead">Tambah, ubah harga/stok, atau hapus produk di sini — perubahan langsung kepake di halaman Produk publik.</p>

        <form id="product-form" class="filter-form" novalidate>
          <input type="hidden" id="product-id" value="" />
          <div class="filter-field">
            <label for="name">Nama produk</label>
            <input type="text" id="name" name="name" required />
          </div>
          <div class="filter-field">
            <label for="category">Kategori</label>
            <input type="text" id="category" name="category" required />
          </div>
          <div class="filter-field">
            <label for="price">Harga (Rp)</label>
            <input type="number" id="price" name="price" min="0" required />
          </div>
          <div class="filter-field">
            <label for="stock">Stok</label>
            <input type="number" id="stock" name="stock" min="0" required />
          </div>
          <p id="product-error" class="form-error" role="alert" hidden></p>
          <div class="dashboard-actions">
            <button type="submit" id="product-submit" class="btn-primary">Tambah produk</button>
            <button type="button" id="product-cancel" class="btn-secondary" hidden>Batal edit</button>
          </div>
        </form>

        <table class="product-table" id="product-table">
          <thead>
            <tr><th>Nama</th><th>Kategori</th><th>Harga</th><th>Stok</th><th>Aksi</th></tr>
          </thead>
          <tbody id="product-table-body"></tbody>
        </table>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/dashboard.js"></script>
</body>
</html>
